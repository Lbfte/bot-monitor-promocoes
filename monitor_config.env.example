# ============================================================
# Monitor de Promoções — configuração
# Copie este arquivo para monitor_config.env e preencha.
# ============================================================

# --- OBRIGATÓRIOS ------------------------------------------

# Canal fonte: só o username, sem o @.
SOURCE_CHANNEL=SamuelF3lipePromo

# Token do bot que vai PUBLICAR. Peça ao @BotFather com /newbot.
BOT_TOKEN=

# Canal de destino.
#   Canal público:  @meucanaldepromos
#   Canal privado:  -1001234567890  (use: python tools/get_chat_id.py)
# O bot precisa ser ADMINISTRADOR do canal, com permissão de publicar.
DEST_CHAT_ID=

# --- COMPORTAMENTO -----------------------------------------

# true = mostra o que seria publicado, sem publicar nada.
DRY_RUN=false

# Máximo de posts por rodada (evita bater no limite do Telegram).
MAX_POSTS_PER_RUN=10

# Segundos de espera entre publicações. O limite é ~20 msg/min por chat.
SEND_DELAY=4

# Na PRIMEIRA execução, publicar as últimas N mensagens.
# 0 = só marca o ponto de partida e publica daí em diante (recomendado).
BACKFILL=0

# --- FILTROS (todos opcionais) -----------------------------

# Só repassa mensagens que tenham link.
REQUIRE_LINK=true

# Se preenchido, SÓ publica posts que contenham alguma destas palavras.
# Ex: ALLOW_KEYWORDS=notebook,ssd,monitor,teclado
ALLOW_KEYWORDS=

# Nunca publica posts que contenham alguma destas palavras.
# Ex: BLOCK_KEYWORDS=rifa,sorteio,curso
BLOCK_KEYWORDS=

# Faixa de preço em reais. 0 = sem limite.
# Atenção: com qualquer filtro de preço ativo, posts sem preço legível
# no texto são descartados.
MIN_PRICE=0
MAX_PRICE=0

# --- APARÊNCIA ---------------------------------------------

# Texto fixo no fim de cada post (aceita HTML da Bot API).
# Ex: FOOTER_TEXT=<b>Siga @meucanaldepromos</b>
FOOTER_TEXT=

# Adiciona link para a mensagem original no canal fonte.
INCLUDE_SOURCE_LINK=false

# --- ALERTAS POR PALAVRA-CHAVE -----------------------------

# Aceita comandos no privado do bot (/monitorar, /parar, /lista) e avisa
# cada inscrito quando uma promoção casa com a palavra dele.
ALERTS_ENABLED=true

# Chave que criptografa o arquivo de inscrições (subscribers.json).
# Ele é commitado no repositório, que é público — sem esta chave, os chat IDs
# e os interesses de cada inscrito ficariam expostos.
# Gere a sua com: python tools/gerar_chave.py
SUBSCRIBERS_KEY=
